# Environment Variables — Prerna Global Services

# ============================================================
# Contact Form Email (via Resend)
# Get your API key at https://resend.com
# ============================================================
RESEND_API_KEY=re_...

# Email address that will RECEIVE contact form submissions
CONTACT_FORM_TO_EMAIL=Info@prernaglobalservices.com

# Email address to show as "From" (must be verified domain in Resend)
CONTACT_FORM_FROM_EMAIL=noreply@prernaglobalservices.com

# ============================================================
# Site URL (used for sitemap and OG tags)
# ============================================================
NEXT_PUBLIC_SITE_URL=https://prernaglobalservices.com
