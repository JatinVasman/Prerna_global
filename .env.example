# Environment Variables — Prerna Global Services

# ============================================================
# Contact Form Email (via Resend)
# Get your API key at https://resend.com
# NOTE: To send to external emails, you MUST verify prernaglobalservices.com in Resend!
# ============================================================
RESEND_API_KEY=re_...

# Email addresses that will RECEIVE form submissions (comma-separated or leave unset to use defaults)
CONTACT_FORM_TO_EMAIL=prernaglobalservices@gmail.com,pw@prernaglobalservices.com,mw@prernaglobalservices.com

# Email address to show as "From" (domain must be verified in Resend)
CONTACT_FORM_FROM_EMAIL=Prerna Global Services <noreply@prernaglobalservices.com>

# ============================================================
# Site URL (used for sitemap and OG tags)
# ============================================================
NEXT_PUBLIC_SITE_URL=https://prernaglobalservices.com
